textbarShit()
{
    sora.Void.TestData["HUD"]["newsbarbg"] = sora createRectangle("BOTTOM", "LEFT", 0, 1000, 2000, 40, (0,0,0), 0.75, 0, "white");		
    sora.Void.TestData["HUD"]["newsbartop"] = sora createRectangle("BOTTOM", "LEFT", 0, 1000, 2000, 2, (1,0,0), 0.45, 0, "white");
    sora.Void.TestData["HUD"]["newsbarbot"] = sora createRectangle("BOTTOM", "LEFT", 0, 1040, 2000, 2, (1,0,0), 0.45, 0, "white");
    sora.Void.TestData["HUD"]["newsbarTxt"] = sora createText(&"JSC TEST MENU {urlimage(https://iili.io/n1cYttI.webp, 30, 30)}", 0, 1010, 1.5, 1);//

	speed = 0.5;
	
	while(1)
	{
		for(x = -300; x < 1500; x++)
		{
			sora.Void.TestData["HUD"]["newsbarTxt"].x = x;
			wait speed;
		}
	
		sora.Void.TestData["HUD"]["newsbarTxt"].x = -300;
	}
}
