ArrayTest()
{
    sora.TestItems = [];
    sora.TestItems["First"] = 10;
    sora.TestItems["Second"] = 20;

    if (sora.TestItems.size() == 2)
    {
        sora iprintln("PASS: array size == 2");
    }
    else
    {
        sora iprintln("FAIL: array size");
    }

    if (sora.TestItems.contains("First"))
    {
        sora iprintln("PASS: array contains First");
    }
    else
    {
        sora iprintln("FAIL: array contains First");
    }

    if (sora.TestItems.empty())
    {
        sora iprintln("FAIL: array unexpectedly empty");
    }
    else
    {
        sora iprintln("PASS: array is not empty");
    }
}

