        sora SetEntityState("Sora", "PeterPanFly");
        sora SetEntityState("PartyMember1", "PeterPanFly");
        sora SetEntityState("PartyMember2", "PeterPanFly");

        sora.KingdomHeartVars["PeterPanFly"] = true;
    }
    else
    {
        sora SetEntityState("Sora", "Reset");
        sora SetEntityState("PartyMember1", "Reset");
        sora SetEntityState("PartyMember2", "Reset");

